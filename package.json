{
  "name": "mediacube-ui-v2",
  "version": "0.0.336",
  "license": "MIT",
  "description": "Design system for Mediacube services",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "dist/utils/dayjs.js",
    "src/utils/dayjs.ts"
  ],
  "keywords": [
    "vue3",
    "nuxt3",
    "library",
    "design-system"
  ],
  "author": "dsa@mediacube.io",
  "aiCatalog": {
    "index": "./dist/ai-catalog/index.json",
    "unpkgTemplate": "https://unpkg.com/mediacube-ui-v2@${version}/dist/ai-catalog/index.json",
    "jsdelivrTemplate": "https://cdn.jsdelivr.net/npm/mediacube-ui-v2@${version}/dist/ai-catalog/index.json"
  },
  "files": [
    "dist",
    "!dist/assets/icons"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./base.scss": "./dist/base.scss",
    "./variables.scss": "./dist/variables.scss",
    "./fonts/*": "./dist/fonts/*",
    "./components/elements/*": {
      "types": "./dist/types/components/elements/*/index.d.ts",
      "import": "./dist/components/elements/*/index.js",
      "default": "./dist/components/elements/*/index.js"
    },
    "./components/patterns/*/*/*": {
      "types": "./dist/types/components/patterns/*/*/*/index.d.ts",
      "import": "./dist/components/patterns/*/*/*/index.js",
      "default": "./dist/components/patterns/*/*/*/index.js"
    },
    "./components/patterns/*/*": {
      "types": "./dist/types/components/patterns/*/*/index.d.ts",
      "import": "./dist/components/patterns/*/*/index.js",
      "default": "./dist/components/patterns/*/*/index.js"
    },
    "./components/patterns/*": {
      "types": "./dist/types/components/patterns/*/index.d.ts",
      "import": "./dist/components/patterns/*/index.js",
      "default": "./dist/components/patterns/*/index.js"
    },
    "./components/templates/*/*/*": {
      "types": "./dist/types/components/templates/*/*/*/index.d.ts",
      "import": "./dist/components/templates/*/*/*/index.js",
      "default": "./dist/components/templates/*/*/*/index.js"
    },
    "./components/templates/*/*": {
      "types": "./dist/types/components/templates/*/*/index.d.ts",
      "import": "./dist/components/templates/*/*/index.js",
      "default": "./dist/components/templates/*/*/index.js"
    },
    "./components/templates/*": {
      "types": "./dist/types/components/templates/*/index.d.ts",
      "import": "./dist/components/templates/*/index.js",
      "default": "./dist/components/templates/*/index.js"
    },
    "./composables/*": {
      "types": "./dist/types/composables/*.d.ts",
      "import": "./dist/composables/*.js",
      "default": "./dist/composables/*.js"
    },
    "./enums/ui/*": {
      "types": "./dist/types/enums/ui/*.d.ts",
      "import": "./dist/enums/ui/*.js",
      "default": "./dist/enums/ui/*.js"
    },
    "./enums/*": {
      "types": "./dist/types/enums/*.d.ts",
      "import": "./dist/enums/*.js",
      "default": "./dist/enums/*.js"
    },
    "./types/*": "./dist/types/*",
    "./utils/*": {
      "types": "./dist/types/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./consts/*": "./dist/consts/*.js",
    "./iconsSprite.svg": "./dist/iconsSprite.svg",
    "./iconsSpriteFlags.svg": "./dist/iconsSpriteFlags.svg",
    "./iconsSpriteGrads.svg": "./dist/iconsSpriteGrads.svg",
    "./tokens": "./dist/assets/tokens/json/index.js",
    "./styles/*": "./dist/styles/*",
    "./tokens/*": "./dist/tokens/*",
    "./ai-catalog.json": "./dist/ai-catalog/index.json",
    "./ai-catalog/catalog.schema.json": "./dist/ai-catalog/catalog.schema.json",
    "./ai-catalog/for-ai.md": "./dist/ai-catalog/FOR_AI.md",
    "./ai-catalog/recommended-entrypoints.json": "./dist/ai-catalog/recommended-entrypoints.json",
    "./ai-catalog/types/*": "./dist/ai-catalog/types/*",
    "./ai-catalog/types/*/*": "./dist/ai-catalog/types/*/*",
    "./ai-catalog/enums/*": "./dist/ai-catalog/enums/*",
    "./ai-catalog/enums/*/*": "./dist/ai-catalog/enums/*/*"
  },
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && node scripts/build-ai-catalog.mjs",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:ai-catalog": "node scripts/build-ai-catalog.mjs",
    "verify:ai-catalog": "node scripts/build-ai-catalog.mjs && node scripts/verify-ai-catalog.mjs",
    "mcp:ui": "node scripts/mcp-ui-server.mjs",
    "type-check": "vue-tsc --build --force",
    "test:datepicker": "vitest run",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:scss-to-json": "node scss-to-json.js",
    "build:icons": "node create-svg-sprite.js",
    "prerelease": "yarn build:icons && yarn build:scss-to-json && yarn build-storybook && yarn build",
    "release": "standard-version",
    "prepublishOnly": "npm run verify:ai-catalog"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^9.0.2",
    "@vueuse/core": "^11.1.0",
    "@vueuse/shared": "^11.1.0",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "vite-plugin-static-copy": "^2.1.0",
    "vue-3-slider-component": "^1.0.1",
    "vue-imask": "^7.6.1",
    "vue-multiselect": "^3.0.0-beta.3",
    "vue-router": "^4.4.3",
    "vue3-cropperjs": "^1.1.1",
    "xss": "^1.0.15"
  },
  "peerDependencies": {
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.6.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rushstack/eslint-patch": "^1.8.0",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-onboarding": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@storybook/vue3": "^8.2.9",
    "@storybook/vue3-vite": "^8.2.9",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-storybook": "^0.8.0",
    "eslint-plugin-vue": "^9.23.0",
    "glob": "^13.0.6",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.2.5",
    "sass": "^1.81.0",
    "sass-embedded": "^1.77.8",
    "sass-extract": "^3.0.0",
    "sass-loader": "^16.0.1",
    "standard-version": "^9.5.0",
    "storybook": "^8.2.9",
    "svgo": "^4.0.1",
    "svgstore": "^3.0.1",
    "typescript": "~5.4.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.1.9",
    "vue-docgen-api": "^4.79.2",
    "vue-tsc": "^2.0.21",
    "zod": "^4.3.6"
  },
  "volta": {
    "node": "20.10.0",
    "yarn": "1.22.22"
  }
}
